# Optional RPC overrides. HyperSync supplies historical logs; RPCs are used at the live head.
OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com
SCROLL_RPC_URL=https://scroll-rpc.publicnode.com
# Optional archive-capable fallbacks for block-exact lending and historical price calls.
OPTIMISM_RPC_FALLBACK_URL=
SCROLL_RPC_FALLBACK_URL=
# Required for exact historical prices and Safe/Aave snapshots. These are never
# substituted with the public/current URLs above.
# Optional overrides. Historical eth_call defaults to dRPC and falls back to
# PublicNode; set these first-priority URLs for higher limits/private access.
OPTIMISM_ARCHIVE_RPC_URL=
OPTIMISM_ARCHIVE_RPC_FALLBACK_URL=
SCROLL_ARCHIVE_RPC_URL=
SCROLL_ARCHIVE_RPC_FALLBACK_URL=
ENVIO_PG_SCHEMA=etherfi_enriched
ENVIO_INDEXER_PORT=9900
# The patched Envio scheduler defaults to these conservative values. Keep the
# chain-wide cap above 1 so healthy fallback RPCs can continue overlapping work.
ENVIO_MAX_CHAIN_CONCURRENCY=4
ENVIO_MAX_IN_FLIGHT_CHUNKS_PER_PARTITION=1
