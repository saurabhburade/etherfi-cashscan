# Required only when explicitly applying the additive migration.
DATABASE_URL=postgresql://user:password@localhost:5432/etherfi

# Required only when explicitly applying Hasura metadata.
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080
HASURA_GRAPHQL_ADMIN_SECRET=
# The Hasura source pointing at DATABASE_URL. Defaults to "default".
HASURA_SOURCE=default

# Current PriceProvider refresh (finalized eth_call, refreshed by `worker`).
OPTIMISM_RPC_URL=https://your-optimism-rpc.example
SCROLL_RPC_URL=https://your-scroll-rpc.example

# Historical PriceProvider backfill. These endpoints must support archive
# eth_call at the event block; latest-only RPCs are rejected rather than used.
OPTIMISM_ARCHIVE_RPC_URL=https://your-optimism-archive-rpc.example
OPTIMISM_ARCHIVE_RPC_FALLBACK_URL=https://your-second-optimism-archive-rpc.example
SCROLL_ARCHIVE_RPC_URL=https://your-scroll-archive-rpc.example
SCROLL_ARCHIVE_RPC_FALLBACK_URL=https://your-second-scroll-archive-rpc.example
